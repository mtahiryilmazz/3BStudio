<Window x:Class="ThreeBStudio.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="3BStudio · Yerel Masaüstü GUI &amp; Web Portal Başlatıcı"
        Width="1380"
        Height="880"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Üst Stüdyo Kontrol Çubuğu -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel LastChildFill="False">
                <!-- Sol: Marka + Sunucu Durumu -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentTeal}" Margin="0,0,10,0">
                        <TextBlock Text="3B" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="3BStudio Yerel Başlatıcı" Foreground="White" FontWeight="Bold" FontSize="13.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="StatusText" Text="Hazırlanıyor..." Foreground="#CBD5E1" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Orta/Sağ: Görünüm Geçişi ve Sunucu Kontrolleri -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnShowDesktopGui"
                            Content="Masaüstü GUI"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="BtnShowDesktopGui_Click" />
                    <Button x:Name="BtnOpenBrowser"
                            Content="Web Portalı (Tarayıcı)"
                            Style="{StaticResource SecondaryDarkButton}"
                            Margin="0,0,8,0"
                            Click="BtnOpenBrowser_Click" />
                    <Button x:Name="BtnShowDashboard"
                            Content="Başlatıcı &amp; Loglar"
                            Style="{StaticResource SecondaryDarkButton}"
                            Margin="0,0,8,0"
                            Click="BtnShowDashboard_Click" />
                    <Button x:Name="BtnReloadWebView"
                            Content="Yenile"
                            Style="{StaticResource SecondaryDarkButton}"
                            Margin="0,0,8,0"
                            Click="BtnReloadWebView_Click" />
                    <Button x:Name="BtnToggleServer"
                            Content="Sunucuyu Başlat"
                            Style="{StaticResource SecondaryDarkButton}"
                            Click="BtnToggleServer_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Ana İçerik Alanı -->
        <Grid Grid.Row="1">
            <!-- Panel 1: Yerel Başlatıcı Kontrol Paneli + Canlı Konsol -->
            <Grid x:Name="DashboardPanel" Margin="20" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hızlı Başlatma Kartları -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Kart 1: Masaüstü GUI -->
                    <Border Grid.Column="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Masaüstü GUI Modu (Gömülü WebView2)" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="3BStudio'yu ayrı bir tarayıcı açmadan doğrudan bu Windows penceresi içinde GPU WebGL hızlandırmasıyla çalıştırır." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,14" />
                            <Button x:Name="BtnLaunchDesktopCard" Content="Masaüstü GUI'yi Başlat ve Aç" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="BtnShowDesktopGui_Click" />
                        </StackPanel>
                    </Border>

                    <!-- Kart 2: Web Portalı -->
                    <Border Grid.Column="2" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Yerel Web Portalı &amp; Android QR Erişimi" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="PortalUrlHint" Text="http://localhost:3000 adresini varsayılan tarayıcıda açar ve aynı ağdaki telefondan QR ile fotoğraf aktarımını etkinleştirir." TextWrapping="Wrap" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,6,0,14" />
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnLaunchPortalCard" Content="Tarayıcıda Web Portalını Aç" Style="{StaticResource LightCardButton}" Margin="0,0,8,0" Click="BtnOpenBrowser_Click" />
                                <Button x:Name="BtnCopyLanUrl" Content="Yerel Ağ URL'sini Kopyala" Style="{StaticResource LightCardButton}" Click="BtnCopyLanUrl_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sistem & Repo Yapılandırma Şeridi -->
                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Proje Klasörü:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="RepoPathText" Text="Aranıyor..." FontFamily="Consolas" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Port:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="PortTextBox" Text="3000" Width="64" Padding="6,4" FontFamily="Consolas" FontSize="12" Margin="0,0,16,0" VerticalContentAlignment="Center" />

                                <TextBlock Text="Node.js:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="NodeStatusText" Text="Kontrol ediliyor..." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <TextBlock Text="Bağımlılıklar:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="DepsStatusText" Text="Kontrol ediliyor..." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <TextBlock Text="ComfyUI (:8188):" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="ComfyStatusText" Text="Taranıyor..." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <TextBlock Text="WebView2:" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                <TextBlock x:Name="WebView2StatusText" Text="Kontrol ediliyor..." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnInstallDeps" Content="npm install Çalıştır" Style="{StaticResource LightCardButton}" Margin="0,0,8,0" Click="BtnInstallDeps_Click" />
                            <Button x:Name="BtnCheckEnv" Content="Durumu Yenile" Style="{StaticResource LightCardButton}" Click="BtnCheckEnv_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Canlı Sunucu Konsol Çıktısı -->
                <Border Grid.Row="2" Background="{StaticResource BgConsole}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="12" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="CANLI YEREL SUNUCU KONSOLU" Foreground="#94A3B8" FontWeight="Bold" FontSize="10.5" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Logları Temizle" Style="{StaticResource SecondaryDarkButton}" Padding="10,4" FontSize="11" Click="BtnClearLogs_Click" />
                        </DockPanel>
                        <TextBox x:Name="ConsoleOutputBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#E2E8F0"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="NoWrap" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Panel 2: Tam Ekran Gömülü Masaüstü GUI (WebView2) -->
            <Grid x:Name="DesktopGuiPanel" Visibility="Collapsed">
                <wv2:WebView2 x:Name="StudioWebView" />

                <!-- Sunucu başlarken görünen şık yükleme katmanı -->
                <Border x:Name="WebViewLoadingOverlay" Background="#F20F172A" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="3BStudio Yerel Sunucusu Başlatılıyor..." Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="WebViewLoadingDetail" Text="Node.js Express + Vite sunucusu hazırlanıyor, lütfen bekleyin." Foreground="#CBD5E1" FontSize="12.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
